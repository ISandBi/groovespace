PORT=5000
# 0.0.0.0 para que la app móvil (en el mismo WiFi) llegue al backend; vacío = solo localhost en desarrollo.
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/groovespace
FRONTEND_URL=http://localhost:5173

# Pago simulado: con true no se cobra nada y se usa una pantalla de pago de prueba.
# En desarrollo también se activa solo si no pones credenciales reales de PayPal.
PAYMENTS_SIMULATED=true
# PayPal Orders v2 (developer.paypal.com → Apps & Credentials). PAYPAL_ENV: sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
# Webhook en /api/payments/webhook con los eventos CHECKOUT.ORDER.APPROVED y PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=replace_me

STAFF_USERNAME=replace_me
STAFF_PASSWORD=replace_with_a_long_unique_password
STAFF_TOKEN_SECRET=replace_with_at_least_32_random_bytes
BAND_TOKEN_SECRET=replace_with_a_different_32_byte_secret
ENGINEER_TOKEN_SECRET=replace_with_another_independent_32_byte_secret

# Credenciales de ingeniería. En desarrollo déjalas comentadas: se usan las de prueba (ana_groove/ana2026, etc.; ver README).
# En producción descomenta y pon valores propios.
# ENGINEER_ANA_USERNAME=ana_engineer
# ENGINEER_ANA_PASSWORD=replace_with_a_unique_password
# ENGINEER_MATEO_USERNAME=mateo_engineer
# ENGINEER_MATEO_PASSWORD=replace_with_a_unique_password
# ENGINEER_LUCIA_USERNAME=lucia_engineer
# ENGINEER_LUCIA_PASSWORD=replace_with_a_unique_password
# ENGINEER_DIEGO_USERNAME=diego_engineer
# ENGINEER_DIEGO_PASSWORD=replace_with_a_unique_password

# Mini SIEM solo para entornos QA/desarrollo; no se habilita en producción.
QA_MONITORING_ENABLED=false
QA_INGEST_TOKEN=replace_with_at_least_32_random_characters
QA_HASH_SECRET=replace_with_an_independent_32_byte_secret

# ---------- Almacenamiento de archivos grandes (demos, entregables, archivos de banda) ----------
# local = carpeta privada en el servidor (desarrollo). s3 = Amazon S3 o compatible (MinIO, R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./private-storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Sólo para S3 compatibles (MinIO/R2); déjalo vacío con AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
DEMO_MAX_MB=200
DELIVERABLE_MAX_MB=500

# ---------- Correo (invitaciones, recordatorios). Sin llaves, los correos sólo se escriben en la consola ----------
RESEND_API_KEY=
MAIL_FROM=GrooveSpace <no-reply@tu-dominio.com>

# ---------- Contratos ----------
# internal = firma electrónica simple. Para NOM-151 registra un proveedor en src/modules/contracts/provider.js.
CONTRACT_PROVIDER=internal
